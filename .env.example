# 이 파일을 .env 로 복사한 뒤 하나의 인증 경로만 채운다.
# adk run/web 은 에이전트 폴더에서 상위로 올라가며 .env 를 찾으므로 루트 .env 하나면 된다.

# ① Google AI Studio (API 키 발급: https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=<your-gemini-api-key>

# ② Vertex AI (GCP 프로젝트, gcloud auth application-default login 필요)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=<your GCP Project ID>
# GOOGLE_CLOUD_LOCATION=global

# (선택) part04_llm_agent LiteLLM 예제
# ANTHROPIC_API_KEY=<your-anthropic-key>

# 사용할 Gemini 모델 (코드 기본값: gemini-flash-latest)
# 무료 키는 모델마다 분당 5회·일 20회 정도로 제한된다. 한도에 걸리거나 504가 나면 다른 모델로 바꾼다.
# 사용 가능한 모델 목록: python -c "from google import genai; print([m.name for m in genai.Client().models.list()])"
# ADK_MODEL=gemini-3.5-flash-lite
